// Obelisk online service (issue #3). Deploy with `npm run deploy` after
// `npx wrangler secret put RELAYER_PRIVATE_KEY`; see README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "obelisk-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Serve only the workers.dev URL; per-version preview URLs stay off.
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    // 968 = BOT Chain testnet, 677 = mainnet (once chain/deployments/677.json exists).
    "CHAIN_ID": "968"
  },
  "durable_objects": {
    "bindings": [{ "name": "RELAY_QUEUE", "class_name": "RelayQueue" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayQueue"] }],
  // Provisioned by the first deploy; ids pinned so later deploys reuse them.
  "kv_namespaces": [{ "binding": "INDEX", "id": "33e64093414b4c5a9177986f5c54a63b" }],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "obelisk-service-blobs" }]
}
