{
  "compilerOptions": {
    "lib": ["es2023"],
    "module": "node16",
    "target": "es2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["hardhat.config.ts", "eip712.ts", "test/**/*.ts", "test-support/**/*.ts", "scripts/**/*.ts", "abi/**/*.ts", "artifacts/**/*.d.ts"]
}
