      "scenes": [
        "v1:task/planning"
      ]
    },
    {
      "id": "install-2",
      "role": "mainnet-builder",
      "title": "安装所选方法",
      "cli": [
        "skill",
        "fetch",
        "608430d0d29afeb96f59ffc1ae04e33b6ec7315fde7f4ddd3640fdd6c48895ce",
        "--harness",
        "codex",
        "--confirm"
      ]
    },
    {
      "id": "use-2",
      "role": "mainnet-builder",
      "title": "完成范围调整和访谈准备",
      "prompt": "$small-project-evidence-loop 现在还没有成品，但我想先知道同学怎么记摘录。帮我做一份不诱导回答的简短访谈提纲和记录表，区分他们真正在做的事和我自己的猜测。 保存到项目里。",
      "scenes": [
        "v1:task/planning"
      ]
    }
