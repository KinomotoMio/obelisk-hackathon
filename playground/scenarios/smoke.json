    { "id": "B", "label": "用户 B", "harness": "codex", "skills": ["obelisk", "obelisk-distill"] }
  ],
  "steps": [
    {
      "id": "a-hello",
      "role": "A",
      "title": "A 在 Claude Code 里查看场景词表",
