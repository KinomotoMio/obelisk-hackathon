      "fake": { "commands": [["skill", "scenes"]] }
    },
    { "id": "a-skills", "role": "A", "title": "A 查看自己的 Skill 库", "cli": ["skill", "list"] },
    {
      "id": "b-hello",
      "role": "B",
      "title": "B 在 Codex 里查看场景词表",
      "prompt": "运行 `obelisk skill scenes`，用一句话告诉我词表版本和有几个维度。",
      "fake": { "commands": [["skill", "scenes"]] }
    }
  ]
}
