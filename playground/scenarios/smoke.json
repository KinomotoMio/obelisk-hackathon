{
  "schema": "obelisk.playground.scenario/1",
  "name": "smoke",
  "title": "冒烟：两个 Codex 角色各说一句话，各自建索引，截一张 A 的 Sessions 页",
  "network": {
    "serviceUrl": null,
    "chainId": 968
  },
  "defaults": {
    "maxTurns": 3,
    "timeoutMinutes": 5
  },
  "roles": [
    {
      "id": "A",
      "label": "作者 A",
      "harness": "codex",
      "skills": [
        "obelisk",
        "obelisk-distill"
      ]
    },
    {
      "id": "B",
      "label": "用户 B",
      "harness": "codex",
      "skills": [
        "obelisk",
        "obelisk-distill"
      ]
    }
  ],
  "steps": [
    {
      "id": "a-hello",
      "role": "A",
      "title": "A 在 Codex 里查看场景词表",
      "prompt": "运行 `obelisk skill scenes`，用一句话告诉我词表版本和有几个维度。",
      "fake": {
        "commands": [
          [
            "skill",
            "scenes"
          ]
        ]
      }
    },
    {
      "id": "a-build",
      "role": "A",
      "title": "A 建立自己的索引",
      "cli": [
        "--build"
      ]
    },
    {
      "id": "b-hello",
      "role": "B",
      "title": "B 在 Codex 里查看场景词表",
      "prompt": "运行 `obelisk skill scenes`，用一句话告诉我词表版本和有几个维度。",
      "fake": {
        "commands": [
          [
            "skill",
            "scenes"
          ]
        ]
      }
    },
    {
      "id": "b-build",
      "role": "B",
      "title": "B 建立自己的索引",
      "cli": [
        "--build"
      ]
    },
    {
      "id": "a-sessions-shot",
      "role": "A",
      "title": "A 的 Sessions 页",
      "route": "#/sessions",
      "caption": "A 的索引里只有 A 自己的 session",
      "timeoutMinutes": 2
    }
  ]
}
